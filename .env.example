POSTGRES_PASSWORD=replace-with-a-long-random-password
# The app's own database login, which can only see each user's own rows (a different long random password).
GEOLOGS_APP_DB_PASSWORD=replace-with-another-long-random-password
GEOLOGS_TOKEN=replace-with-a-long-random-token
# Optional: a token phones use to send locations (/api/ingest/...); it cannot read anything.
GEOLOGS_INGEST_TOKEN=
GEOLOGS_PUBLISHED_PORT=8765
# Who may reach the app's port: this machine only (the default), or 0.0.0.0 for the whole network.
# GEOLOGS_BIND=127.0.0.1
GEOLOGS_TIMEZONE=America/Chicago
# Update source: stable installs approved releases; edge follows each tested push to main.
GEOLOGS_UPDATE_CHANNEL=stable
# Set automatically by the release updater. Leave unset for source builds.
# GEOLOGS_REVISION=
# Optional: database connections the server keeps for its requests (10 by default).
# GEOLOGS_DB_POOL_SIZE=10
GEOAPIFY_API_KEY=
# Optional: Mapbox Search Box API token; choose the provider in Settings.
MAPBOX_ACCESS_TOKEN=
GEOLOGS_WEBHOOK_URL=
GEOLOGS_WEBHOOK_TOKEN=
GEOLOGS_WEBHOOK_SECRET=


# Optional: automatic US fuel prices (free key: https://www.eia.gov/opendata/register.php)
EIA_API_KEY=

# Optional: a photo of your city, in its weather, behind the Home page (free key: https://unsplash.com/developers)
UNSPLASH_ACCESS_KEY=

# Optional: email for invites and password resets. GEOLOGS_PUBLIC_URL is where people open GeoLogs.
GEOLOGS_PUBLIC_URL=
GEOLOGS_SMTP_HOST=
# GEOLOGS_SMTP_PORT=587
# GEOLOGS_SMTP_SECURITY=starttls   # or ssl (port 465), or none
GEOLOGS_SMTP_USERNAME=
GEOLOGS_SMTP_PASSWORD=
GEOLOGS_SMTP_FROM=GeoLogs <geologs@example.com>
