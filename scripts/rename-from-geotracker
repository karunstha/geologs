#!/bin/sh
# Upgrade a Compose install made before the project was renamed from
# Geotracker to GeoLogs: rename the GEOTRACKER_* keys in .env, then the
# PostgreSQL role and database from geotracker to geologs, in place, so the
# existing ./data/postgres keeps working. Safe to run again.
set -eu

project_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$project_root"

# First, because the new docker-compose.yaml refuses to load without GEOLOGS_TOKEN.
if [ -f .env ] && grep -q '^GEOTRACKER_' .env; then
    # Rewrite in place: Compose mounts this file into the app, and a new file
    # would leave the container reading the old one.
    old_umask=$(umask)
    umask 077
    sed 's/^GEOTRACKER_/GEOLOGS_/' .env > .env.renaming
    umask "$old_umask"
    cat .env.renaming > .env
    rm .env.renaming
    echo "Renamed the GEOTRACKER_* keys in .env to GEOLOGS_*."
fi

running=$(docker compose ps -q --status running db)
if [ -z "$running" ]; then
    echo "The database container is not running. Start it with: docker compose up -d db" >&2
    exit 1
fi

# Inside the container, local socket connections need no password.
psql_as() {
    user=$1
    shift
    docker compose exec -T db psql -X -q -v ON_ERROR_STOP=1 -tA -U "$user" -d postgres "$@"
}

if psql_as geotracker -c 'SELECT 1' >/dev/null 2>&1; then
    admin=geotracker
elif psql_as geologs -c 'SELECT 1' >/dev/null 2>&1; then
    admin=geologs
else
    echo "Could not connect as geotracker or geologs. Inspect the database container; the database was not changed." >&2
    exit 1
fi

# old role, new role, old database, new database, and how the old role's password is hashed.
state=$(psql_as "$admin" -c "SELECT concat_ws(' ',
    (SELECT count(*) FROM pg_roles WHERE rolname = 'geotracker'),
    (SELECT count(*) FROM pg_roles WHERE rolname = 'geologs'),
    (SELECT count(*) FROM pg_database WHERE datname = 'geotracker'),
    (SELECT count(*) FROM pg_database WHERE datname = 'geologs'),
    COALESCE((SELECT left(rolpassword, 3) FROM pg_authid WHERE rolname = 'geotracker'), '-'))")
set -- $state
old_role=$1 new_role=$2 old_db=$3 new_db=$4 hash=$5
if [ "$old_role$new_role" = 11 ] || [ "$old_db$new_db" = 11 ]; then
    echo "Both geotracker and geologs exist in PostgreSQL. Inspect them; the database was not changed." >&2
    exit 1
fi
if [ "$hash" = md5 ]; then
    # PostgreSQL clears an MD5 password when its role is renamed.
    echo "The geotracker role has an MD5 password, which a rename would clear. The database was not changed." >&2
    echo "Set it again under scram-sha-256 (ALTER ROLE geotracker PASSWORD ...), then rerun this script." >&2
    exit 1
fi

if [ "$old_role" = 0 ] && [ "$old_db" = 0 ]; then
    echo "PostgreSQL already uses the geologs role and database."
else
    docker compose stop app
    psql_as "$admin" >/dev/null <<'SQL'
DO $$
BEGIN
    IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname = 'geologs_rename') THEN
        CREATE ROLE geologs_rename SUPERUSER LOGIN;
    END IF;
END
$$;
SQL
    # A role cannot rename itself, so a short-lived helper role does it. The
    # health check can hold a brief connection to the database; retry past it.
    attempt=1
    until psql_as geologs_rename >/dev/null <<'SQL'
SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname = 'geotracker' AND pid <> pg_backend_pid();
SELECT pg_sleep(1);
SELECT 'ALTER DATABASE geotracker RENAME TO geologs' WHERE EXISTS (SELECT FROM pg_database WHERE datname = 'geotracker')
\gexec
SELECT 'ALTER ROLE geotracker RENAME TO geologs' WHERE EXISTS (SELECT FROM pg_roles WHERE rolname = 'geotracker')
\gexec
SQL
    do
        if [ "$attempt" -ge 5 ]; then
            echo "Renaming failed; see the error above. Rerun this script once the cause is fixed." >&2
            exit 1
        fi
        attempt=$((attempt + 1))
        sleep 2
    done
    psql_as geologs -c 'DROP ROLE geologs_rename'
    echo "Renamed the PostgreSQL role and database from geotracker to geologs."
fi

docker compose up -d --build
echo "GeoLogs is running. Update any cron job that calls ./geotracker to call ./geologs."
