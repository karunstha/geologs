#!/bin/sh
# Copy the existing Compose named volume to the project data directory.
set -eu

project_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$project_root"

container=$(docker compose ps -a -q db)
if [ -z "$container" ]; then
    echo "No existing Compose database container found. Nothing to migrate." >&2
    exit 1
fi
source_volume=$(docker inspect -f '{{range .Mounts}}{{if and (eq .Destination "/var/lib/postgresql/data") (eq .Type "volume")}}{{.Name}}{{end}}{{end}}' "$container")
if [ -z "$source_volume" ]; then
    echo "The database container is not using a named volume. Refusing to overwrite project data." >&2
    exit 1
fi

mkdir -p data
if [ -e data/postgres ] && [ -n "$(ls -A data/postgres)" ]; then
    echo "data/postgres is not empty. Inspect it before migrating; the old volume is untouched." >&2
    exit 1
fi
if [ -e data/postgres.importing ]; then
    echo "data/postgres.importing already exists. Inspect or remove that incomplete copy first." >&2
    exit 1
fi

docker compose stop app db
rmdir data/postgres 2>/dev/null || true
mkdir data/postgres.importing
if ! docker run --rm --platform linux/amd64 --entrypoint sh \
    -v "$source_volume:/from:ro" \
    -v "$project_root/data/postgres.importing:/to" \
    postgis/postgis:17-3.5 -c 'cp -a /from/. /to/ && test -f /to/PG_VERSION'; then
    echo "Copy failed. The original volume is untouched; inspect data/postgres.importing." >&2
    exit 1
fi
mv data/postgres.importing data/postgres
docker compose up -d --build
echo "Postgres now uses $project_root/data/postgres. Original volume $source_volume was retained."
